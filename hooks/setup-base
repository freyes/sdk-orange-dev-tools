#!/bin/bash
set -e

# Ensure universe component is enabled (needed for mini-dinstall)
apt-get update
if ! apt-cache policy mini-dinstall 2>/dev/null | grep -q 'Candidate:' | grep -qv '(none)'; then
    apt-get install -y software-properties-common
    add-apt-repository -y universe
    apt-get update
fi

# Install the full Ubuntu packaging toolchain
apt-get install -y sbuild debhelper devscripts ubuntu-dev-tools dpkg-dev \
    build-essential mmdebstrap dput mini-dinstall distro-info schroot \
    debootstrap uidmap software-properties-common

# Add workshop user to the sbuild group (idempotent)
WORKSHOP_USER=$(getent passwd 1000 | cut -d: -f1)
if [ -n "$WORKSHOP_USER" ] && ! id -nG "$WORKSHOP_USER" | grep -qw sbuild; then
    usermod -aG sbuild "$WORKSHOP_USER"
fi

# Install git-ubuntu snap (best-effort — do NOT fail the hook if snap install fails)
command -v git-ubuntu >/dev/null 2>&1 || snap install git-ubuntu --classic 2>/dev/null || \
    echo "WARN: git-ubuntu snap install failed — snapd may not be available"

# System-wide PATH for SDK helper scripts
cat <<EOF >/etc/profile.d/orange-dev-tools.sh
export PATH="\$SDK/bin:\$PATH"
EOF

# System-wide dput configuration for local repository uploads
cat <<'EOF' >/etc/dput.cf
[local]
fqdn = localhost
method = local
incoming = /project/local-repo/mini-dinstall/incoming
allow_unsigned_uploads = 1
post_upload_command = mini-dinstall --batch
EOF
